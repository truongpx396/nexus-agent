    {
      "id": "steps",
      "x": 660,
      "y": 152,
      "width": 422,
      "height": 328,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "seed": 105047,
      "version": 2,
      "versionNonce": 294367715,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785519548629,
      "link": null,
      "locked": false,
      "type": "text",
      "roundness": null,
      "fontSize": 12.5,
      "fontFamily": 2,
      "text": "1    Lookup {namespace}/{name}@{version} via the signed alias map\n1a   Descriptor re-verification against the admitted digest\n2    Abort check (cancellation / stop hook)\n3    Schema validation        4  Semantic validation\n5    Speculative safety classifier + Rule-of-Two evaluation\n6    Input backfill (defaults, absolute-path coercion)\n7    PreToolUse hooks\n8    Permission chain  ←  the total order on the left\n8a   Canonical digest = approval binding AND idempotency key\n8b   Approval gate — durable suspend at zero token cost\n9    Secret injection from the vault (the model saw a handle)\n9a   Digest re-verify — divergence → approval_mismatch\n9b   Write-ahead idempotency claim, committed in_flight\n10   Execute in the per-tenant sandbox (limits, net deny)\n10a  Claim resolution — probe or human, never re-execute\n11   Result budgeting — cap / paginate, spill to storage\n12   PostToolUse hooks     12a  Authorization receipt\n13   Audit receipt — hash-chained, over digests\n14   Append tool_result (paired, envelope-encrypted)\n15   Record taint transition\n16   Error classification + content-free cost span",
      "originalText": "1    Lookup {namespace}/{name}@{version} via the signed alias map\n1a   Descriptor re-verification against the admitted digest\n2    Abort check (cancellation / stop hook)\n3    Schema validation        4  Semantic validation\n5    Speculative safety classifier + Rule-of-Two evaluation\n6    Input backfill (defaults, absolute-path coercion)\n7    PreToolUse hooks\n8    Permission chain  ←  the total order on the left\n8a   Canonical digest = approval binding AND idempotency key\n8b   Approval gate — durable suspend at zero token cost\n9    Secret injection from the vault (the model saw a handle)\n9a   Digest re-verify — divergence → approval_mismatch\n9b   Write-ahead idempotency claim, committed in_flight\n10   Execute in the per-tenant sandbox (limits, net deny)\n10a  Claim resolution — probe or human, never re-execute\n11   Result budgeting — cap / paginate, spill to storage\n12   PostToolUse hooks     12a  Authorization receipt\n13   Audit receipt — hash-chained, over digests\n14   Append tool_result (paired, envelope-encrypted)\n15   Record taint transition\n16   Error classification + content-free cost span",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 10,
      "index": "ak",
      "autoResize": true
    },
    {
