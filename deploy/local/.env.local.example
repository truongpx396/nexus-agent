# =============================================================================
# Nexus Agent — LOCAL deploy-test (.env) example.
# Copy to `.env` in this directory. Safe dev defaults — do NOT use in production.
# =============================================================================

# Build locally (default) or pull a specific published tag by setting these to a
# real Docker Hub namespace + tag.
IMAGE_NAMESPACE=nexus-agent
IMAGE_TAG=local

# Datastore + secrets (dev defaults).
POSTGRES_PASSWORD=nexus
VAULT_TOKEN=dev-root-token

# Identity (Casdoor) — console is on http://localhost:8000 in this profile.
OIDC_ISSUER=http://casdoor:8000
OIDC_CLIENT_ID=nexus-agent
OIDC_CLIENT_SECRET=change-me

# Sandbox broker socket (host-side nexus-sandboxd). For a pure local test without
# the broker you can point this at a throwaway path.
SANDBOX_BROKER_SOCKET=/run/nexus/sandboxd.sock
