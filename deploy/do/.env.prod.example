# =============================================================================
# Nexus Agent — production (.env) example for the DigitalOcean droplet profile.
# Copy to `.env` ON THE DROPLET (scripts/deploy.sh expects it at the compose dir)
# and fill in real values. NEVER commit the filled-in .env.
#
# The deploy workflow injects IMAGE_TAG / IMAGE_NAMESPACE over SSH; the rest are
# host-side secrets seeded once during bootstrap.
# =============================================================================

# --- Image source (set by CI over SSH; defaults shown for manual runs) --------
IMAGE_NAMESPACE=your-dockerhub-namespace
IMAGE_TAG=latest

# --- Public hostname + TLS ----------------------------------------------------
APP_DOMAIN=app.example.com
ACME_EMAIL=ops@example.com

# --- Datastore secrets --------------------------------------------------------
POSTGRES_PASSWORD=change-me-strong

# --- Secrets/KMS (OpenBao). Replace dev-mode token in real production. ---------
VAULT_TOKEN=change-me-strong

# --- Identity (Casdoor OIDC) --------------------------------------------------
OIDC_ISSUER=https://app.example.com/auth
OIDC_CLIENT_ID=nexus-agent
OIDC_CLIENT_SECRET=change-me

# --- Sandbox broker socket (nexus-sandboxd on the host) -----------------------
SANDBOX_BROKER_SOCKET=/run/nexus/sandboxd.sock
