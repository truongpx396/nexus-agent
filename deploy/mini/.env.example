# =============================================================================
# Nexus Agent — MINI single-tenant profile
# Copy to `.env` and edit before `docker compose -f docker-compose-mini.yml up`.
# Do NOT commit the filled-in `.env`. The model-provider key does NOT go here —
# seed it into the vault (OpenBao) so it is read at tool-exec time (FR-034).
# =============================================================================

# --- Datastore credentials ---------------------------------------------------
POSTGRES_PASSWORD=change-me

# --- Secrets / KMS (OpenBao) -------------------------------------------------
# Dev-mode root token for local/eval only. Use a sealed backend in production.
VAULT_TOKEN=dev-root-token

# --- Identity: Casdoor (OIDC) ------------------------------------------------
OIDC_ISSUER=http://casdoor:8000
OIDC_CLIENT_ID=nexus-agent
OIDC_CLIENT_SECRET=change-me

# --- Sandbox broker (nexus-sandboxd) -----------------------------------------
# Host path of the minimal-privilege sandbox-broker Unix socket, bind-mounted
# read-only into nexus-control. This is the single-host create path (FR-059a) —
# it is NOT the container-runtime socket. Run nexus-sandboxd as a host systemd
# unit; never bind-mount /var/run/docker.sock into the app to work around it.
SANDBOX_BROKER_SOCKET=/run/nexus/sandboxd.sock
