# Copy this file to .env (gitignored) and set real values for local development.
# Never commit .env — only this .env.example (with placeholders) is tracked.
# docker-compose.yml reads these via ${VAR} / ${VAR:-default} / ${VAR:?...}.

# --- PostgreSQL (docker-compose.yml: postgres service) -----------------------
# Required — docker-compose.yml has no baked-in default and will refuse to
# start the postgres service until this is set here.
POSTGRES_PASSWORD=changeme-dev-only

# Optional — values shown are what docker-compose.yml falls back to if unset.
POSTGRES_USER=nexus
POSTGRES_DB=nexus_agent

# --- Redis (docker-compose.yml: redis service) --------------------------------
# No credentials required for local dev today: the redis service in
# docker-compose.yml does not set `requirepass` and is bound to 127.0.0.1 only.
# If you need auth locally, add a REDIS_PASSWORD var here and wire
# `command: redis-server --requirepass ${REDIS_PASSWORD}` into the redis
# service in docker-compose.yml.
