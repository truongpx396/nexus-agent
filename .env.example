# Copy this file to .env and fill in real local-dev values before running
# `docker compose up`. .env is gitignored — never commit it. Every value
# below is a placeholder; none of these are real or usable credentials.

# ── Postgres (docker-compose.yml: postgres service) ─────────────────────────
POSTGRES_USER=nexus_dev
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_DB=nexus_agent
# Host port to publish Postgres on (bound to 127.0.0.1). Optional — defaults
# to 5432 if unset.
POSTGRES_PORT=5432

# ── Redis (docker-compose.yml: redis service) ────────────────────────────────
REDIS_PASSWORD=change-me-local-dev-only
# Host port to publish Redis on (bound to 127.0.0.1). Optional — defaults to
# 6379 if unset.
REDIS_PORT=6379
