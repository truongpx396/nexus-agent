# .env.example
#
# Copy this file to `.env` (gitignored — never commit real values) and fill in
# your own local values. docker-compose.yml references every variable below
# via `${VAR:?set in .env}`, so compose refuses to start rather than silently
# falling back to a hardcoded/default credential (security-and-owasp S1/S2/S4).
#
# Placeholders below are intentionally not usable credentials — replace them
# before running `docker compose up`.

# --- Postgres (control/data plane state store) ---
POSTGRES_USER=nexus_dev
POSTGRES_PASSWORD=__set_me__
POSTGRES_DB=nexus_agent
POSTGRES_PORT=5432

# --- Redis (cache / queue) ---
REDIS_PASSWORD=__set_me__
REDIS_PORT=6379
